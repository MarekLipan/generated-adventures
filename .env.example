# Copy to .env and fill in what you use. Every setting has a default in
# src/generated_adventures/core/config.py; these are the ones you are most
# likely to change.

# --- Credentials ---
# Google Gemini: required when any *_PROVIDER below is "gemini".
# Note: Gemini image generation has no free-tier quota and needs billing enabled.
GOOGLE_API_KEY=your_google_api_key_here
# Hugging Face: only needed the first time, to download gated models.
# HUGGING_FACE_HUB_TOKEN=your_huggingface_token_here

# --- Story text (LLM) ---
# gemini | ollama | openai-compatible
LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.1-flash-lite

# --- Images ---
# flux-klein (local) | gemini (cloud) | http (your local image server)
IMAGE_PROVIDER=flux-klein
# auto | cuda | mps | cpu
IMAGE_DEVICE=auto

# Apple Silicon: load a pre-quantized transformer so Klein fits in 32 GB without
# CPU offload (about 2 min per image on an M1 Max instead of about 9).
# FLUX_KLEIN_GGUF_TRANSFORMER=unsloth/FLUX.2-klein-9B-GGUF:flux-2-klein-9b-Q2_K.gguf
# NVIDIA GPU: nothing to set; Klein quantizes with bitsandbytes (NF4) by default.

# First run only: allow downloading model weights from the Hugging Face Hub.
# IMAGE_HF_OFFLINE=false

# --- Narration ---
# kokoro (local; needs the model files, see docs/narration.md) | gemini | none
TTS_PROVIDER=kokoro
